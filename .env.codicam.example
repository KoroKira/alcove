# Authenticated server stack: copy to .env, chmod 600, then follow SETUP.md.
# Use shell-compatible assignments; quote values containing spaces or special characters.
# Generate each secret separately: openssl rand -hex 32
COMPOSE_PROJECT_NAME=alcove
# Pin a published revision tag or digest before deployment (not a moving :main tag).
ALCOVE_IMAGE=ghcr.io/korokira/alcove:sha-REPLACE_WITH_40_CHARACTER_COMMIT_SHA
INGRESS_NETWORK=cloudflared_default
APP_PORT=8000
KEYCLOAK_PORT=8080
FRONTEND_URL=https://alcove.codicam.fr
REGISTRATION_CONTACT_EMAIL=
OIDC_SERVER_URL=https://auth-alcove.codicam.fr
DATA_DIR=/srv/appdata/alcove
BACKUP_DIR=/srv/backups/alcove
BACKUP_KEEP_DAYS=14
# Opt-in only; false keeps every completed backup. Monitor disk usage.
BACKUP_PRUNE=false

POSTGRES_USER=pad
POSTGRES_DB=pad
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
OIDC_REALM=alcove
OIDC_CLIENT_ID=alcove
OIDC_CLIENT_SECRET=CHANGE_ME_AFTER_CLIENT_CREATION
# scripts/setup.sh creates the client and replaces this value without printing it.

OLLAMA_DEFAULT_MODEL=llama3.2
AI_RATE_PER_MINUTE=12
AI_DAILY_QUOTA=200
AI_GLOBAL_CONCURRENCY=2
AI_USER_CONCURRENCY=1
AI_QUEUE_TIMEOUT_SECONDS=20
# Optional account-linked MCP OAuth (provision dedicated clients first; docs/MCP.md).
MCP_OAUTH_ENABLED=false
MCP_OAUTH_RESOURCE=https://alcove.example.org/mcp
MCP_OAUTH_CLIENT_IDS=alcove-codex,alcove-chatgpt
MCP_OAUTH_WRITE_ENABLED=false
