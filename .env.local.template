# Local dev config — no Docker, no Keycloak
# Copy to .env.local and adjust if needed
# ⚠️  This setup is for LOCAL, single-user use on your own machine only.
#     Never expose these ports to a network without adding auth and passwords.

PAD_DEV_MODE=true

# PostgreSQL (brew install postgresql@16)
# Homebrew postgres uses your macOS username with no password
POSTGRES_USER=__YOUR_MAC_USER__
POSTGRES_PASSWORD=
POSTGRES_DB=pad
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (brew install redis) — no password by default
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Not used in dev mode — leave blank
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SERVER_URL=
OIDC_REALM=

# Internal paths (relative to src/backend/)
STATIC_DIR=../frontend/dist
ASSETS_DIR=../frontend/dist/assets
FRONTEND_URL=http://localhost:8000
REDIRECT_URI=http://localhost:8000/api/auth/callback
API_WORKERS=1

# Local pad sync — saved as .excalidraw files after each 5-min auto-save
SYNC_DIR=~/Documents/pads/

# Local terminal (ttyd)
TTYD_URL=http://localhost:7681

# Ollama AI (brew install ollama && ollama pull llama3.2)
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
