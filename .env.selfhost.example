# .env for docker-compose.selfhost.yml
# Copy to `.env` and fill in the values below.

# Random long password for the Postgres user. Generate one, e.g.:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING

# Public URL Alcove is reached at from your browser. With Tailscale serve on
# the default HTTPS port, this is https://<server-hostname>.<your-tailnet>.ts.net
FRONTEND_URL=https://alcove-server.tail02afcd.ts.net

# Where Postgres/Redis/pads persistent data live on the host. Under /srv/appdata
# so the nightly backup script picks it up automatically.
DATA_DIR=/srv/appdata/alcove
